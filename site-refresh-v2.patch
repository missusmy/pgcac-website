+    margin-left: calc(1.15em + 0.35rem);
+    margin-top: 0.15rem;
+    margin-bottom: 0.75rem;
+    text-indent: calc(-1.15em - 0.35rem);
+    font-size: 1rem;
+    line-height: 1.3;
+    white-space: nowrap;
+  }
+  .company-url .globe-icon {
+    margin-right: 0.35rem;
+    background-color: currentColor;
+    mask: url(/static/img/globe-icon.svg) no-repeat center;
+    -webkit-mask: url(/static/img/globe-icon.svg) no-repeat center;
+    mask-size: contain;
+    -webkit-mask-size: contain;
+    display: inline-block;
+    width: 1.15em;
+    height: 1.15em;
+    vertical-align: middle;
+  }
+  .company-url a {
+    word-break: break-word;
+    white-space: break-spaces;
+    font-weight: 400!important;
+  }
+  .company-desc {
+    font-size: 1rem;
+    margin-bottom: 0.75rem;
+  }
+
+  @media (min-width: 992px) {
+    .col-lg-1-5 {
+      flex: 0 0 12.5%;
+      max-width: 12.5%;
+    }
+  }
+
+  .level-benefactor {
+    img.organisation-logo {
+      max-height: 80px;
+    }
+  }
+
+  .level-patron {
+    .sponsor-item {
+      .logo-wrap {
+        width: 262px;
+        height: calc(70px + 1.5rem);
+      }
+    }
+    img.organisation-logo {
+      max-height: 70px;
+    }
+  }
+
+  .level-supporter {
+    .sponsor-item {
+      .logo-wrap {
+        width: 225px;
+        height: calc(60px + 1.5rem);
+      }
+    }
+    img.organisation-logo {
+      max-height: 60px;
+    }
+    .company-desc {
+      font-size: 0.9rem;
+    }
+  }
+
+  .level-friend {
+    .sponsor-item {
+      .logo-wrap {
+        width: 187px;
+        height: calc(50px + 1.5rem);
+      }
+    }
+    img.organisation-logo {
+      max-height: 50px;
+    }
+  }
+}
+
+#sponsorship-levels2 {
+  .table {
+    tbody {
+      tr:nth-of-type(even) {
+        background-color: var(--body-bg-color)!important;
+      }
+      tr:nth-of-type(odd) {
+        background-color: var(--striped-td-bg-color)!important;
+      }
+    }
+    thead {
+      th {
+        color: var(--primary)!important;
+      }
+    }
+  }
+}
+
+[data-theme="light"] {
+  #sponsors-list, #sponsorship-levels2 {
+    .table {
+      tbody {
+        th, td {
+          border-color: #dee2e6!important;
+        }
+        tr:last-child {
+          th, td {
+            border-bottom: 1px solid #dee2e6!important;
+          }
+        }
+      }
+      thead {
+        th {
+          border-left-color: #dee2e6!important;
+        }
+      }
+    }
+  }
+}
+
+[data-theme="dark"] {
+  #sponsors-list, #sponsorship-levels2 {
+    .table {
+      thead, tbody {
+        th, td {
+          &:not(:first-child) {
+            border-left-color: var(--table-td-bdr-color)!important;
+          }
+        }
+      }
+    }
+  }
+  img.organisation-logo {
+    filter: grayscale(100%) brightness(0) invert(1);
+    &.grayscale {
+      filter: grayscale(100%) brightness(2);
+    }
+  }
+}
+
+#help-pgca {
+  .divider {
+    height: 0;
+    border-top: 1px solid #70b5e2;
+    max-width: 90ch;
+  }
+  .fs-2 {
+    @media screen and (max-width: 767px) {
+      font-size: 1.5rem !important;
+    }
+  }
+}
+
+#contact-banner {
+  background-image: url(/static/img/contact-elephants.png);
+  background-image: url(/static/img/contact-elephants.webp);
+  background-size: auto 150%;
+  background-position: calc(50% + 20em) 40%;
+  background-repeat: no-repeat;
+}
+
+#community-support {
+  background: #333 url(/static/img/global-community-bg.jpg) center center no-repeat;
+  background-image: url(/static/img/global-community-bg.webp);
+  background-size: cover;
+  color: #fff;
+  p a {
+    color: #fff;
+    &:hover {
+      color: #74BFF1;
+    }
+  }
+}
+
+#mailing-address {
+  @media screen and (min-width: 768px) {
+    &:before {
+      content: '';
+      display: block;
+      width: 0;
+      left: -1rem;
+      top: 1rem;
+      bottom: 1rem;
+      overflow: hidden;
+      position: absolute;
+      border-left: 2px solid var(--primary);
+    }
+  }
+}
+
+#faq-banner, #trademarks-banner, #domains-banner, #privacy-banner, #downloads-banner {
+  background-image: url(/static/img/faq-elephant.png);
+  background-image: url(/static/img/faq-elephant.webp);
+  background-size: auto 180%;
+  background-position: calc(50% + 16em) 45%;
+  background-repeat: no-repeat;
+}
+
+.faq-card {
+  border-radius: 0!important;
+  border-width: 0!important;
+  background-color: var(--body-bg-color);
+  .card-body {
+    @media screen and (min-width: 768px) {
+      padding-left: 2.5rem;
+      padding-right: 2.5rem;
+    }
+  }
+  .h5, p, ul {
+    max-width: 90ch;
+  }
+  .h5 {
+    font-weight: 700!important;
+  }
+  p {
+    a {
+      font-weight: 400!important;
+    }
+  }
+}
+
+#domains-info {
+  ul {
+    @media screen and (min-width: 768px) {
+      column-count: 2;
+    }
+  }
+}
\ No newline at end of file
